# アカウントロック画面（画面設計）
# kind: free — 警告の面と文字だけが、ほかの 2 枚と違う部品である。
# 警告文は面の「中」に置く——座標で重ねるのではなく、面が中身を持つ。

use "../../shared/ui-parts.dgm"

free {
  frame     frame:
  title     title:"アカウントがロックされています"
  banner    alert:
  message   error:"連続して 5 回ログインに失敗したため、このアカウントは一時的に利用できません。"

  contact   label:"解除をご希望の場合は、システム管理者にご連絡ください。"

  deskField ""
  deskLabel label:"問い合わせ先"
  deskBox   textbox:"情報システム部　内線 4120"

  back      secondary:"ログイン画面に戻る"
  help      link:"よくある質問"
}

layout {
  frame @ ( 40,  20) 380x392

  stack frame (down; gap: 20; pad: 30) {
    title
    banner
    contact
    deskField
    back
    help
  }

  stack banner (down; gap: 0; pad: 10) { message }
  stack deskField (down; gap: 2; pad: 0) { deskLabel ; deskBox }
}

style {
  theme: default
}
