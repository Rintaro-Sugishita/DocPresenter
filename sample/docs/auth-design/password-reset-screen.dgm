# パスワード再設定画面（画面設計）
# kind: free — ログイン画面と同じ部品を使うので、見た目の記述はここに無い。

use "../../shared/ui-parts.dgm"

free {
  frame     frame:
  title     title:"パスワードの再設定"
  lead      body:"登録済みのメールアドレスを入力してください。再設定用のリンクをお送りします。"

  mailLabel label:"メールアドレス"
  mailBox   textbox:"yamada@example.co.jp"
  mailHint  hint:"送信まで数分かかることがあります"

  send      primary:"再設定メールを送る"
  cancel    secondary:"キャンセル"
  back      link:"ログイン画面に戻る"
}

layout {
  frame     @ ( 40,  20) 380x300
  title     @ ( 70,  50)
  lead      @ ( 70,  82)

  mailLabel @ ( 70, 126)
  mailBox   @ ( 70, 146)
  mailHint  @ ( 70, 182)

  send      @ ( 70, 216)
  cancel    @ ( 70, 260)
  back      @ ( 70, 304)
}

style {
  theme: default
}
