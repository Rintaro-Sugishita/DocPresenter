# ログイン画面（画面設計）
# kind: free — 画面はすべて座標が意味を持つので自由配置。
# 見た目は部品テンプレートが持つ。この file に残るのは「何が、どこに」だけである。

use "../../shared/ui-parts.dgm"

free {
  frame    frame:
  title    title:"サービスにログイン"

  idLabel  label:"ログイン ID"
  idBox    textbox:"yamada@example.co.jp"
  idHint   hint:"社員番号を入力してください"

  pwLabel  label:"パスワード"
  pwBox    textbox:

  keepBox  checkbox:
  keepText label:"ログイン状態を保持する"

  submit   primary:"ログイン"
  forgot   link:"パスワードを忘れた方"
}

layout {
  frame    @ ( 40,  20) 380x330
  title    @ ( 70,  50)

  idLabel  @ ( 70,  96)
  idBox    @ ( 70, 116)
  idHint   @ ( 70, 152)

  pwLabel  @ ( 70, 182)
  pwBox    @ ( 70, 202)

  keepBox  @ ( 70, 250)
  keepText @ ( 96, 250) 200x16

  submit   @ ( 70, 284)
  forgot   @ ( 70, 330)
}

style {
  theme: default
}
