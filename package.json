{
  "name": "docpresenter",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --build",
    "check": "tsc --build && node tools/check.mjs",
    "build:vscode": "tsc --build && node tools/build-vscode.mjs",
    "build:cli": "tsc --build && node tools/build-cli.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.2",
    "pdf-lib": "^1.17.1"
  }
}
