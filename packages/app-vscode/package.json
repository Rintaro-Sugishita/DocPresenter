{
  "name": "docpresenter",
  "displayName": "DocPresenter",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "docpresenter",
  "private": true,
  "license": "SEE LICENSE IN legal/LICENSE.draft.md",
  "repository": { "type": "git", "url": "https://github.com/Rintaro-Sugishita/DocPresenter.git", "directory": "packages/app-vscode" },
  "engines": { "vscode": "^1.95.0" },
  "icon": "icon.png",
  "galleryBanner": { "color": "#1f4e8c", "theme": "dark" },
  "categories": ["Visualization", "Programming Languages", "Other"],
  "keywords": [
    "design", "design document", "specification", "documentation", "markdown",
    "diagram", "drawing", "flowchart", "state diagram", "architecture diagram", "wireframe",
    "table", "mermaid", "pdf", "pptx", "powerpoint", "export", "review", "git diff",
    "設計書", "仕様書", "作図", "図", "表", "フローチャート", "画面設計", "レビュー"
  ],
  "main": "./media/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "dgm",
        "aliases": ["DocPresenter Diagram", "dgm"],
        "extensions": [".dgm"],
        "configuration": "./syntaxes/dgm.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dgm",
        "scopeName": "source.dgm",
        "path": "./syntaxes/dgm.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "docpresenter.sheets",
        "displayName": "DocPresenter",
        "selector": [{ "filenamePattern": "*.md" }],
        "priority": "option"
      },
      {
        "viewType": "docpresenter.diagram",
        "displayName": "%customEditor.diagram.displayName%",
        "selector": [{ "filenamePattern": "*.dgm" }],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "docpresenter.init", "title": "%command.init.title%", "category": "DocPresenter" },
      { "command": "docpresenter.newDocument", "title": "%command.newDocument.title%", "category": "DocPresenter" },
      { "command": "docpresenter.newDiagram", "title": "%command.newDiagram.title%", "category": "DocPresenter" },
      { "command": "docpresenter.openEditor", "title": "%command.openEditor.title%", "category": "DocPresenter" },
      { "command": "docpresenter.openToSide", "title": "%command.openToSide.title%", "category": "DocPresenter", "icon": "$(open-preview)" },
      { "command": "docpresenter.build", "title": "%command.build.title%", "category": "DocPresenter" },
      { "command": "docpresenter.buildAs", "title": "%command.buildAs.title%", "category": "DocPresenter" },
      { "command": "docpresenter.check", "title": "%command.check.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportHtml", "title": "%command.exportHtml.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportPdf", "title": "%command.exportPdf.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportPptx", "title": "%command.exportPptx.title%", "category": "DocPresenter" },
      { "command": "docpresenter.readBackPptx", "title": "%command.readBackPptx.title%", "category": "DocPresenter" },
      { "command": "docpresenter.formatDiagram", "title": "%command.formatDiagram.title%", "category": "DocPresenter" },
      { "command": "docpresenter.importPdfReview", "title": "%command.importPdfReview.title%", "category": "DocPresenter" }
    ],
    "menus": {
      "editor/title": [
        { "command": "docpresenter.openToSide", "when": "resourceExtname =~ /^\\.(md|dgm)$/ && !activeCustomEditorId", "group": "navigation" },
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/ && !activeCustomEditorId", "group": "navigation" },
        { "command": "docpresenter.exportHtml", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@1" },
        { "command": "docpresenter.exportPdf", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@2" },
        { "command": "docpresenter.exportPptx", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@3" }
      ],
      "editor/context": [
        { "command": "docpresenter.openToSide", "when": "resourceExtname =~ /^\\.(md|dgm)$/ && !activeCustomEditorId", "group": "navigation@9" }
      ],
      "explorer/context": [
        { "command": "docpresenter.newDocument", "when": "explorerResourceIsFolder", "group": "navigation@8" },
        { "command": "docpresenter.newDiagram", "when": "explorerResourceIsFolder", "group": "navigation@8" },
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/", "group": "navigation@9" },
        { "command": "docpresenter.readBackPptx", "when": "resourceExtname == .pptx", "group": "navigation@9" },
        { "command": "docpresenter.formatDiagram", "when": "resourceExtname == .dgm", "group": "navigation@9" },
        { "command": "docpresenter.importPdfReview", "when": "resourceExtname == .pdf", "group": "navigation@9" }
      ],
      "commandPalette": [
        { "command": "docpresenter.init", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.check", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.newDocument", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.newDiagram", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.readBackPptx", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.formatDiagram", "when": "resourceExtname == .dgm" },
        { "command": "docpresenter.importPdfReview", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/" },
        { "command": "docpresenter.openToSide", "when": "resourceExtname =~ /^\\.(md|dgm)$/" },
        { "command": "docpresenter.exportHtml", "when": "activeCustomEditorId == docpresenter.sheets" },
        { "command": "docpresenter.exportPdf", "when": "activeCustomEditorId == docpresenter.sheets" },
        { "command": "docpresenter.exportPptx", "when": "activeCustomEditorId == docpresenter.sheets" }
      ]
    },
    "keybindings": [
      { "command": "docpresenter.openToSide", "key": "ctrl+k v", "mac": "cmd+k v", "when": "editorLangId == dgm" }
    ],
    "configuration": {
      "title": "DocPresenter",
      "properties": {
        "docpresenter.commitKey": {
          "type": "string",
          "enum": ["ctrl-enter", "enter", "shift-enter", "alt-enter"],
          "enumDescriptions": [
            "%config.commitKey.ctrl-enter%", "%config.commitKey.enter%",
            "%config.commitKey.shift-enter%", "%config.commitKey.alt-enter%"
          ],
          "default": "ctrl-enter",
          "description": "%config.commitKey.description%"
        },
        "docpresenter.outDir": {
          "type": "string",
          "default": "out/build",
          "description": "%config.outDir.description%"
        },
        "docpresenter.pdfReviewNotes": {
          "type": "boolean",
          "default": true,
          "description": "%config.pdfReviewNotes.description%"
        }
      }
    }
  },
  "dependencies": {
    "@docpresenter/base": "*",
    "@docpresenter/build": "*",
    "@docpresenter/diagram": "*",
    "@docpresenter/editor": "*",
    "@docpresenter/markdown": "*",
    "@docpresenter/pdf": "*"
  }
}
