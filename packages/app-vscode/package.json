{
  "name": "docpresenter",
  "displayName": "DocPresenter",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "docpresenter",
  "private": true,
  "license": "SEE LICENSE IN legal/LICENSE.draft.md",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "main": "./media/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "docpresenter.sheets",
        "displayName": "DocPresenter",
        "selector": [{ "filenamePattern": "*.md" }],
        "priority": "option"
      },
      {
        "viewType": "docpresenter.diagram",
        "displayName": "%customEditor.diagram.displayName%",
        "selector": [{ "filenamePattern": "*.dgm" }],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "docpresenter.init", "title": "%command.init.title%", "category": "DocPresenter" },
      { "command": "docpresenter.openEditor", "title": "%command.openEditor.title%", "category": "DocPresenter" },
      { "command": "docpresenter.build", "title": "%command.build.title%", "category": "DocPresenter" },
      { "command": "docpresenter.buildAs", "title": "%command.buildAs.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportHtml", "title": "%command.exportHtml.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportPdf", "title": "%command.exportPdf.title%", "category": "DocPresenter" },
      { "command": "docpresenter.exportPptx", "title": "%command.exportPptx.title%", "category": "DocPresenter" }
    ],
    "menus": {
      "editor/title": [
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/ && !activeCustomEditorId", "group": "navigation" },
        { "command": "docpresenter.exportHtml", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@1" },
        { "command": "docpresenter.exportPdf", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@2" },
        { "command": "docpresenter.exportPptx", "when": "activeCustomEditorId == docpresenter.sheets", "group": "docpresenter@3" }
      ],
      "explorer/context": [
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/", "group": "navigation@9" }
      ],
      "commandPalette": [
        { "command": "docpresenter.init", "when": "workspaceFolderCount > 0" },
        { "command": "docpresenter.openEditor", "when": "resourceExtname =~ /^\\.(md|dgm)$/" },
        { "command": "docpresenter.exportHtml", "when": "activeCustomEditorId == docpresenter.sheets" },
        { "command": "docpresenter.exportPdf", "when": "activeCustomEditorId == docpresenter.sheets" },
        { "command": "docpresenter.exportPptx", "when": "activeCustomEditorId == docpresenter.sheets" }
      ]
    },
    "configuration": {
      "title": "DocPresenter",
      "properties": {
        "docpresenter.commitKey": {
          "type": "string",
          "enum": ["ctrl-enter", "enter", "shift-enter", "alt-enter"],
          "enumDescriptions": [
            "%config.commitKey.ctrl-enter%", "%config.commitKey.enter%",
            "%config.commitKey.shift-enter%", "%config.commitKey.alt-enter%"
          ],
          "default": "ctrl-enter",
          "description": "%config.commitKey.description%"
        },
        "docpresenter.outDir": {
          "type": "string",
          "default": "out/build",
          "description": "%config.outDir.description%"
        }
      }
    }
  },
  "dependencies": {
    "@docpresenter/base": "*",
    "@docpresenter/build": "*",
    "@docpresenter/diagram": "*",
    "@docpresenter/editor": "*",
    "@docpresenter/markdown": "*",
    "@docpresenter/pdf": "*"
  }
}
