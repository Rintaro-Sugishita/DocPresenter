{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DocPresenter 拡張を試す",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/app-vscode",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/app-vscode-diagram",
        "${workspaceFolder}/sample"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/app-vscode/media/*.cjs",
        "${workspaceFolder}/packages/app-vscode-diagram/media/*.cjs"
      ],
      "preLaunchTask": "DocPresenter 拡張をビルド"
    }
  ]
}
